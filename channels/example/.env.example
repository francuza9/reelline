# Credentials of the example channel: copy to .env (next to config.yaml, or the
# repo root) and fill in. Never commit real values. Generated by `reelline config env-example`
# from the config's *_env fields (config.yaml names each variable). The engine reads only this
# file, never the shell env, gcloud or ADC; REELLINE__STORAGE__ENV_FILE (absolute) may point to
# another one. A feature fails with the missing key's name only when it runs; (optional): the
# feature works, or is skipped, without it.

# --- models.providers.anthropic ---
# Anthropic API key (console.anthropic.com > API keys). Never ANTHROPIC_API_KEY: that name is
# refused, so the SDK can't pick a key up by itself.
REELLINE_ANTHROPIC_API_KEY=

# --- models.providers.google ---
# Gemini API key (aistudio.google.com > Get API key).
GEMINI_API_KEY=

# --- models.providers.openai ---
# API key of the OpenAI-compatible endpoint (models.providers.openai.base_url); only a role on
# provider openai needs it. (optional)
OPENAI_API_KEY=

# --- models.tts ---
# The channel's stored Gemini TTS voice ID (the channel's voice/ notes).
EXAMPLE_VOICE_ID=

# --- steps.analytics.youtube_api ---
# YouTube Data API v3 key (console.cloud.google.com > APIs & Services > Credentials), restricted
# to that API: views, likes, comments, subscribers. (optional)
YOUTUBE_API_KEY=
# OAuth client ID (type Desktop app) for the YouTube Analytics API; the consent screen must be In
# production. (optional)
YOUTUBE_CLIENT_ID=
# That OAuth client's secret. (optional)
YOUTUBE_CLIENT_SECRET=
# The channel owner's refresh token: written by `python -m reelline.pipeline.stats_auth youtube`.
# (optional)
YOUTUBE_REFRESH_TOKEN=

# --- review.telegram ---
# Bot token from @BotFather (Telegram).
TELEGRAM_BOT_TOKEN=
# The review chat's ID (your own chat with the bot).
TELEGRAM_CHAT_ID=

# --- review.webhook ---
# Bearer token sent to the review webhook (review.webhook). (optional)
REVIEW_WEBHOOK_TOKEN=

# --- notify.slack ---
# Slack incoming webhook URL (api.slack.com/messaging/webhooks). (optional)
SLACK_WEBHOOK_URL=

# --- publish.credits_page ---
# Cloudflare API token with Account > Cloudflare Pages > Edit (dash.cloudflare.com > My Profile >
# API Tokens), same account as R2.
CLOUDFLARE_API_TOKEN=

# --- publish.meta ---
# Meta app ID (developers.facebook.com > My Apps).
META_APP_ID=
# That app's secret (App settings > Basic).
META_APP_SECRET=
# ID of the Facebook Page the reels go to (checked against publish.facebook_page_id).
META_PAGE_ID=
# Never-expiring Page access token (from a long-lived user token) with pages_manage_posts,
# pages_read_engagement, pages_manage_engagement, pages_read_user_content.
META_PAGE_TOKEN=

# --- publish.buffer ---
# Buffer API key (publish.buffer.com > Settings > API).
BUFFER_API_KEY=
# Buffer organization ID.
BUFFER_ORG_ID=
# Buffer channel ID of the Instagram account.
BUFFER_CHANNEL_INSTAGRAM=
# Buffer channel ID of the TikTok account.
BUFFER_CHANNEL_TIKTOK=
# Buffer channel ID of the YouTube channel.
BUFFER_CHANNEL_YOUTUBE=

# --- publish.r2 ---
# Cloudflare account ID (dash.cloudflare.com, the account's overview); also the Pages account.
R2_ACCOUNT_ID=
# R2 API token's S3 access key ID, object read/write on the bucket (R2 > Manage API tokens).
R2_ACCESS_KEY_ID=
# That token's S3 secret access key.
R2_SECRET_ACCESS_KEY=
# S3 endpoint: https://<account id>.r2.cloudflarestorage.com.
R2_ENDPOINT=
# The bucket the reel files go to.
R2_BUCKET=
# The bucket's public r2.dev URL (bucket > Settings > Public access): Buffer fetches the reels
# from it. (optional)
R2_PUBLIC_URL=

# --- publish.tiktok_business ---
# TikTok API for Business app ID (Accounts API, approved for Account Comment > Manage Account
# Comment). (optional)
TIKTOK_BUSINESS_APP_ID=
# That app's secret. (optional)
TIKTOK_BUSINESS_SECRET=
# The authorized account's open_id (its business id). (optional)
TIKTOK_BUSINESS_ID=
# The account's refresh token. (optional)
TIKTOK_BUSINESS_REFRESH_TOKEN=

# --- publish.tiktok ---
# TikTok developer app's client key (Content Posting API). (optional)
TIKTOK_CLIENT_KEY=
# That app's client secret. (optional)
TIKTOK_CLIENT_SECRET=
# The posting account's refresh token (scope video.publish). (optional)
TIKTOK_REFRESH_TOKEN=

# --- render.pixabay ---
# Pixabay API key (pixabay.com/api/docs): stock photos for generic scenes; without it, the image
# library and Commons only. (optional)
PIXABAY_API_KEY=

# --- render.pexels ---
# Pexels API key (pexels.com/api); skipped when empty. (optional)
PEXELS_API_KEY=

# --- render.freesound ---
# Freesound API key (freesound.org/apiv2/apply); scripts/sfx.py fetch only. (optional)
FREESOUND_API_KEY=

# --- per-machine settings (not credentials; any REELLINE__SECTION__KEY works here) ---
# Who restarts a dead approval bot: tick (default) or systemd (the server).
# REELLINE__STEPS__RUN_DAILY__BOT_SUPERVISOR=systemd
